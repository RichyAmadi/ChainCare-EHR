# Copy to .env and adjust. Never commit real secrets.
PORT=4000
LEDGER_MODE=fabric                     # fabric | centralised (baseline)
MONGO_URI=mongodb://localhost:27017/ehr
FABRIC_TEST_NETWORK=/root/ehr/fabric-samples/test-network
FABRIC_CHANNEL=ehrchannel
FABRIC_CHAINCODE=ehr
JWT_SECRET=replace-with-a-long-random-string
DATA_KEY_HEX=replace-with-64-hex-characters-for-a-256-bit-aes-key
RATE_LIMIT_PER_MINUTE=300
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
