{
  "name": "ehr-chaincode",
  "version": "1.0.0",
  "description": "EHR consent, access control and audit chaincode",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "fabric-chaincode-node start",
    "start:server-nontls": "fabric-chaincode-node server --chaincode-address=$CHAINCODE_SERVER_ADDRESS --chaincode-id=$CHAINCODE_ID",
    "test": "jest --preset ts-jest test"
  },
  "dependencies": {
    "fabric-contract-api": "~2.5.8",
    "fabric-shim": "~2.5.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.4.5"
  }
}